# setup pkg
INCLUDE local/pkg

# setup ssh
SYSRC sshd_enable="yes"

LIF "Port 2202" /etc/ssh/sshd_config
LIF "PermitRootLogin no" /etc/ssh/sshd_config
LIF "PasswordAuthentication yes" /etc/ssh/sshd_config

# `service sshd start` exits 1 when already running and fails re-apply
CMD service sshd status >/dev/null 2>&1 || service sshd start


# setup user: default
# -m home, -s shell

CMD pw usershow default >/dev/null 2>&1 || pw useradd default -m -s /bin/sh
CMD sh -c 'echo "default" | pw usermod default -h 0'
CMD chown -R default:default /home/default
CMD chmod 750 /home/default
